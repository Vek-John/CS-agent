# Local `pnpm dev` / `pnpm dev:memory` only. Copy this file to
# .local-data/deepseek.env. Shell variables take precedence over this file.
# OpenNext serializes every standard .env mode, so never store a real key in
# apps/web/.env*, the repository root .env*, Wrangler config, or NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=

# Optional non-secret model override: deepseek-v4-flash or deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-flash

# Memory is safely disabled for the normal `pnpm dev` path. `pnpm dev:memory`
# enables it only when this file or the shell does not set an explicit flag.
# Uncomment either value to override the command (`false` always stays off).
# MEMORY_ENABLED=false

# Optional durable store. Leave empty for the explicitly reported process-local
# InMemory fallback. Apply migrations before first use with:
# MEMORY_DATABASE_URL='postgresql://...' pnpm memory:migrate
MEMORY_DATABASE_URL=

# Recommended with PostgreSQL so the anonymous browser identity survives a
# server restart. Use a random value of at least 16 characters; never commit it.
MEMORY_PRINCIPAL_SECRET=

# Optional semantic recall. Omit these to keep structured recall available
# without any embedding provider or credential.
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_TOKEN=
MEMORY_EMBEDDING_MODEL=
