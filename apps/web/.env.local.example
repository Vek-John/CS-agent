# Local Next.js development only. Copy this file to apps/web/.env.development.local.
# Do not copy it to .env.local: OpenNext production builds can include that file.
# Keep the real key out of Git.
DEEPSEEK_API_KEY=

# Optional non-secret model override: deepseek-v4-flash or deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-flash
