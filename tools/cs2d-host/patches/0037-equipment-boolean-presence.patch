+/// Equipment presence is known only for an actual Boolean property value.
+pub(crate) fn prop_optional_bool(e: &Entity, name: &str) -> Option<bool> {
+    match e.get_property_by_name(name) {
+        Ok(FieldValue::Boolean(value)) => Some(*value),
+        _ => None,
     }
