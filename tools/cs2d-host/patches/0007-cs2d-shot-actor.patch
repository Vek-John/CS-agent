+#[cfg(test)]
+mod shot_actor_tests {
+    use super::Event;
+
+    #[test]
+    fn shot_actor_serializes_known_and_explicit_unknown_without_other_fields() {
+        for actor in [Some("test-actor".to_string()), None] {
+            let event = Event::Shot { tick: 64, t: 1.0, x: 0.0, y: 0.0, yaw: 0.0, shooter_steam_id: actor.clone() };
+            let json = serde_json::to_value(&event).unwrap();
+            assert_eq!(json["shooterSteamId"], serde_json::to_value(actor).unwrap());
+            assert_eq!(json.as_object().unwrap().len(), 7);
+            assert_eq!(json["type"], "shot");
+        }
+    }
+}
