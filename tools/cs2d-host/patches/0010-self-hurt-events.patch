+// Game-event pawn IDs are native CS2 handles (15-bit index/17-bit serial).
+// Network CHandle properties carry the packed 14-bit index/low-10-bit serial.
+// Match that documented packed identity, never just a reused entity index.
+pub(crate) fn event_pawn_to_packed(handle: i32) -> Option<u32> {
+    let native = handle as u32;
+    if native == u32::MAX { return None; }
+    let index = native & 0x7fff;
+    if index >= 0x4000 { return None; }
+    let packed = index | (((native >> 15) & 0x3ff) << 14);
+    (packed != 0xffffff).then_some(packed)
+}
+
+fn hurt_packed_owner(packed: u32, class: &str, index: u32, serial: u32, bindings: impl IntoIterator<Item = (u32, u64)>) -> Option<u64> {
+    if class != "CCSPlayerPawn" || index != packed & 0x3fff || (serial & 0x3ff) != packed >> 14 { return None; }
+    let mut owner = None;
+    for (handle, steam) in bindings {
+        if handle != packed { continue; }
+        if steam == 0 || steam == u64::MAX || owner.is_some() { return None; }
+        owner = Some(steam);
+    }
+    owner
+}
+
+pub(crate) fn hurt_victim_steam(ctx: &Context, handle: Option<i32>) -> Option<String> {
+    let packed = event_pawn_to_packed(handle?)?;
+    let pawn = ctx.entities().get_by_index((packed & 0x3fff) as usize).ok()?;
+    let bindings = ctx.entities().iter().filter(|e| e.class().name() == "CCSPlayerController").filter_map(|controller| {
+        match controller.get_property_by_name("m_hPlayerPawn") {
+            Ok(FieldValue::Unsigned32(h)) => Some((*h, prop_u64(controller, "m_steamID"))),
+            _ => None,
+        }
+    });
+    hurt_packed_owner(packed, pawn.class().name(), pawn.index(), pawn.serial(), bindings).map(|steam| steam.to_string())
+}
+
+#[cfg(test)]
+mod hurt_handle_tests {
+    use super::{event_pawn_to_packed, hurt_packed_owner};
+    #[test]
+    fn converts_native_event_handle_without_dropping_serial() {
+        // Source probe: native event, packed controller field and packet entity agree.
+        assert_eq!(event_pawn_to_packed(-269811578), Some(16089222));
+        assert_ne!(event_pawn_to_packed(-269811578), event_pawn_to_packed((-269811578_i32 as u32 + (1 << 15)) as i32));
+        assert_eq!(event_pawn_to_packed(-1), None);
+        assert_eq!(event_pawn_to_packed(0x7fff), None);
+    }
+    #[test]
+    fn validates_current_binding_and_only_the_serial_bits_on_the_wire() {
+        let packed = 16089222;
+        let owner = 76561198000000001;
+        let resolve = |class, index, serial, bindings: Vec<(u32, u64)>| hurt_packed_owner(packed, class, index, serial, bindings);
+        assert_eq!(event_pawn_to_packed((3 << 15) | 134), Some((3 << 14) | 134));
+        assert_eq!(event_pawn_to_packed(0xffffff), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed, owner)]), Some(owner));
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982 + 1024, vec![(packed, owner)]), Some(owner));
+        assert_eq!(resolve("CCSPlayerPawn", 134, 981, vec![(packed, owner)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 135, 982, vec![(packed, owner)]), None);
+        assert_eq!(resolve("CCSObserverPawn", 134, 982, vec![(packed, owner)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(0xffffff, owner)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed + (1 << 14), owner)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed, 0)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed, u64::MAX)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed, owner), (packed, owner + 1)]), None);
+        assert_eq!(resolve("CCSPlayerPawn", 134, 982, vec![(packed, owner), (packed, owner)]), None);
+    }
+
+}
