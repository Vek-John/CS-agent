@@ -0,0 +1,106 @@
+//! Optional active-firearm clip facts. No inventory totals or reserve-unit guesses.
+use source2_demo::prelude::*;
+
+// CHandle on the wire: 14-bit index and low 10 serial bits; get_by_handle alone
+// ignores serial. This is NOT the native event pawn handle's 15-bit layout.
+fn matches_handle(handle: u32, index: u32, serial: u32) -> bool {
+    handle != 0 && handle < 0xffffff && index == (handle & 0x3fff)
+        && (serial & 0x3ff) == (handle >> 14)
+}
+
+// The project-controlled source2-demo decoder preserves m_iClip1's raw u32.
+// No signed inverse is allowed: high-bit wire values must remain distinguishable.
+fn clip_count(value: Option<&FieldValue>) -> Option<u32> {
+    match value {
+        Some(FieldValue::Unsigned32(raw)) => raw.checked_sub(1).filter(|count| *count <= 255),
+        _ => None,
+    }
+}
+
+#[derive(Clone, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct WeaponAmmo {
+    source: &'static str,
+    phase: &'static str,
+    sampled_at_tick: u32,
+    weapon: String,
+    weapon_handle: u32,
+    clip: u32,
+}
+
+fn verified_weapon<'a>(ctx: &'a Context, steam: &str, frame_weapon: &str) -> Option<(&'a Entity, u32, String)> {
+    use crate::props::{prop_i32, prop_u64};
+    let mut controllers = ctx.entities().iter().filter(|e| e.class().name() == "CCSPlayerController"
+        && prop_u64(e, "m_steamID").to_string() == steam);
+    let controller = controllers.next()?;
+    if controllers.next().is_some() { return None; }
+    let unsigned = |entity: &Entity, name: &str| match entity.get_property_by_name(name) {
+        Ok(FieldValue::Unsigned32(value)) => Some(*value), _ => None,
+    };
+    let pawn_handle = unsigned(controller, "m_hPlayerPawn")?;
+    let pawn = ctx.entities().get_by_index((pawn_handle & 0x3fff) as usize).ok()?;
+    if pawn.class().name() != "CCSPlayerPawn" || !matches_handle(pawn_handle, pawn.index(), pawn.serial())
+        || prop_i32(pawn, "m_iHealth") <= 0 { return None; }
+    let side = prop_i32(pawn, "m_iTeamNum");
+    if ![2, 3].contains(&side) || side != prop_i32(controller, "m_iTeamNum") { return None; }
+    match pawn.get_property_by_name("m_lifeState") {
+        Ok(FieldValue::Unsigned32(0) | FieldValue::Signed32(0) | FieldValue::Unsigned8(0)) => {}, _ => return None,
+    }
+    let handle = unsigned(pawn, "m_pWeaponServices.m_hActiveWeapon")?;
+    let entity = ctx.entities().get_by_index((handle & 0x3fff) as usize).ok()?;
+    if !matches_handle(handle, entity.index(), entity.serial()) { return None; }
+    let weapon = crate::weapons::active_weapon_label(ctx, pawn);
+    if weapon != frame_weapon || !crate::weapons::is_firearm_label(&weapon) { return None; }
+    Some((entity, handle, weapon))
+}
+
+pub(crate) fn sample_weapon_ammo(ctx: &Context, steam: &str, frame_weapon: &str) -> Option<WeaponAmmo> {
+    let (entity, handle, weapon) = verified_weapon(ctx, steam, frame_weapon)?;
+    let clip = clip_count(entity.get_property_by_name("m_iClip1").ok())?;
+    Some(WeaponAmmo { source: "SOURCE2_ACTIVE_WEAPON", phase: "TICK_END", sampled_at_tick: ctx.tick(), weapon, weapon_handle: handle, clip })
+}
+
+// Identity is collected at tick start independently of clip availability. The
+// ammo observation itself is collected only after this tick's entity updates.
+pub(crate) fn frame_active_weapon_handle(ctx: &Context, steam: &str, weapon: &str) -> Option<u32> {
+    verified_weapon(ctx, steam, weapon).map(|(_, handle, _)| handle)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn clip_wire_values_do_not_turn_unknown_into_empty() {
+        assert_eq!(clip_count(None), None);
+        assert_eq!(clip_count(Some(&FieldValue::Unsigned32(0))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Unsigned32(1))), Some(0));
+        assert_eq!(clip_count(Some(&FieldValue::Unsigned32(31))), Some(30));
+        assert_eq!(clip_count(Some(&FieldValue::Unsigned32(u32::MAX))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(-1))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(-16))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(31))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(0))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(i32::MIN))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed32(i32::MAX))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Unsigned16(31))), None);
+        assert_eq!(clip_count(Some(&FieldValue::Signed16(-16))), None);
+    }
+    #[test]
+    fn preserved_wire_values_have_unambiguous_bounds() {
+        for raw in [0x80000000, 0xffffffe0, 0xfffffffe, u32::MAX, 257] {
+            assert_eq!(clip_count(Some(&FieldValue::Unsigned32(raw))), None);
+        }
+        for (raw, count) in [(1, 0), (31, 30), (41, 40), (101, 100), (256, 255)] {
+            assert_eq!(clip_count(Some(&FieldValue::Unsigned32(raw))), Some(count));
+        }
+    }
+    #[test]
+    fn handles_require_both_index_and_serial() {
+        let h = 9 | (7 << 14);
+        assert!(matches_handle(h, 9, 7));
+        assert!(matches_handle(h, 9, 7 + 1024));
+        assert!(!matches_handle(h, 9, 8));
+        assert!(!matches_handle(h, 10, 7));
+        for invalid in [0, 0xffffff, u32::MAX] { assert!(!matches_handle(invalid, invalid & 0x3fff, invalid >> 14)); }
+    }
+}
