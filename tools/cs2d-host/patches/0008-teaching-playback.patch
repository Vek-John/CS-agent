diff --git a/apps/app/src/viewer/player/teachingPlayback.ts b/apps/app/src/viewer/player/teachingPlayback.ts
new file mode 100644
--- /dev/null
+++ b/apps/app/src/viewer/player/teachingPlayback.ts
@@ -0,0 +1,38 @@
+type TeachingIdentity = { callId: string; runId: string; cueId: string; generation: number }
+export type TeachingPlaybackRun = {
+  command: TeachingIdentity
+  phase: 'PLAYING' | 'RETURNING'
+  paused: boolean
+}
+type TeachingPlaybackControl = TeachingIdentity & { action: 'pause' | 'resume' | 'cancel' }
+
+/** Local execution guard shared by the tick watcher and deferred startup. */
+export function canAdvanceTeachingPlayback(active: TeachingPlaybackRun | null, expected: TeachingPlaybackRun): boolean {
+  return active === expected && expected.phase === 'PLAYING' && !expected.paused
+}
+
+export function playWithoutTeachingTool(active: TeachingPlaybackRun | null, play: () => void): void {
+  if (!active) play()
+}
+
+/** Controls only the existing visual effect; never starts a new tool or emits completion. */
+export function controlTeachingPlayback(
+  active: TeachingPlaybackRun | null,
+  control: TeachingPlaybackControl,
+  effects: { play(): void; pause(): void; cancel(): void; emitState(): void },
+): boolean {
+  if (!active || active.command.callId !== control.callId || active.command.runId !== control.runId ||
+    active.command.cueId !== control.cueId || active.command.generation !== control.generation) return false
+  if (control.action === 'cancel') {
+    active.paused = true
+    effects.pause()
+    effects.cancel()
+  } else {
+    if (active.phase !== 'PLAYING') return false
+    active.paused = control.action === 'pause'
+    if (active.paused) effects.pause()
+    else effects.play()
+  }
+  effects.emitState()
+  return true
+}
