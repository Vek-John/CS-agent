+
+/// Optional hurt reports require matching descriptor/wire integer metadata and
+/// an actual representable payload. Never coerce floats, handles or missing values.
+pub(crate) fn ev_hurt_report_i32(ge: &GameEvent, key: &str) -> Option<i32> {
+    let kind = ge.validated_value_type(key)?;
+    match (kind, ge.get_value(key).ok()?) {
+        (3 | 4, EventValue::Int(value)) => Some(*value),
+        (5, EventValue::Byte(value)) => Some(i32::from(*value)),
+        _ => None,
+    }
+}
