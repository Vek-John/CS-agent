+/// Type-9 event values are controller-slot references, not native pawn handles.
+/// The u16 subset is intentional; unsupported encodings remain unknown.
+pub(crate) fn event_controller_owner(ctx: &Context, ge: &GameEvent, key: &str) -> Option<String> {
+    if ge.validated_value_type(key) != Some(9) { return None; }
+    let raw = match ge.get_value(key).ok()? { EventValue::Int(raw) => *raw, _ => return None };
+    let raw = u16::try_from(raw).ok()?;
+    if raw == u16::MAX { return None; }
+    let index = (raw & 0xff) as usize + 1;
+    let controller = ctx.entities().get_by_index(index).ok()?;
+    if controller.class().name() != "CCSPlayerController" { return None; }
+    let steam = match controller.get_property_by_name("m_steamID") {
+        Ok(FieldValue::Unsigned64(steam)) if *steam != 0 && *steam != u64::MAX => *steam,
+        _ => return None,
+    };
+    Some(steam.to_string())
+}
