+#[derive(Clone)]
+struct CachedAmmo { identity: WeaponIdentity, ammo: WeaponAmmo }
+
+#[derive(Default)]
+pub(crate) struct AmmoCache {
+    latest: std::collections::HashMap<String, CachedAmmo>,
+    ended_tick: Option<u32>,
+    started_tick: Option<u32>,
+    round: Option<RoundIdentity>,
+    usable_at: Option<u32>,
+    pub(crate) max_entries: usize,
+}
+impl AmmoCache {
+    // Called once per actual tick-end. Replacing the batch removes invalid,
+    // missing, dead, duplicate or disappeared players instead of retaining history.
+    pub(crate) fn capture_end(&mut self, ctx: &Context) {
+        use crate::props::prop_u64;
+        let mut samples = std::collections::HashMap::new();
+        let mut seen = std::collections::HashSet::new();
+        for ctrl in ctx.entities().iter().filter(|e| e.class().name() == "CCSPlayerController") {
+            let steam = prop_u64(ctrl, "m_steamID");
+            if steam == 0 { continue; }
+            let key = steam.to_string();
+            if !seen.insert(steam) { samples.remove(&key); continue; }
+            let Some((entity, identity)) = verified_weapon(ctx, ctrl) else { continue; };
+            let Some(clip) = clip_count(entity.get_property_by_name("m_iClip1").ok()) else { continue; };
+            let ammo = WeaponAmmo { source: "SOURCE2_ACTIVE_WEAPON", phase: "TICK_END", version: 2,
+                sampled_at_tick: ctx.tick(), weapon: identity.weapon.clone(), weapon_handle: identity.weapon_handle, clip };
+            samples.insert(key, CachedAmmo { identity, ammo });
+        }
+        self.replace_end(ctx.tick(), round_identity(ctx), samples);
+    }
+
+    fn replace_end(&mut self, tick: u32, round: Option<RoundIdentity>, samples: std::collections::HashMap<String, CachedAmmo>) {
+        self.latest.clear();
+        self.usable_at = None;
+        if tick != u32::MAX && round.is_some() && self.ended_tick.is_none_or(|old| tick > old) {
+            self.latest = samples;
+        }
+        self.max_entries = self.max_entries.max(self.latest.len());
+        self.ended_tick = Some(tick);
+        self.round = round;
+    }
+
+    // Validate the observed end tick, never synthesize it as current_tick - 1.
+    pub(crate) fn begin_tick(&mut self, tick: u32, round: Option<RoundIdentity>) {
+        self.usable_at = None;
+        if tick != u32::MAX && self.started_tick.is_none_or(|old| tick > old)
+            && self.ended_tick.and_then(|old| old.checked_add(1)) == Some(tick)
+            && round.is_some() && round == self.round {
+            self.usable_at = Some(tick);
+        } else { self.latest.clear(); }
+        self.started_tick = Some(tick);
+    }
+
+    pub(crate) fn for_frame(&self, tick: u32, steam: &str, current: Option<&WeaponIdentity>) -> Option<WeaponAmmo> {
+        if self.usable_at != Some(tick) { return None; }
+        let entry = self.latest.get(steam)?;
+        if Some(&entry.identity) != current || entry.ammo.sampled_at_tick >= tick { return None; }
+        Some(entry.ammo.clone())
+    }
 }
 
