+pub(crate) fn gamerules_bool(ctx: &Context, name: &str) -> Option<bool> {
+    let proxy = ctx.entities().get_by_class_name("CCSGameRulesProxy").ok()?;
+    match proxy.get_property_by_name(name) { Ok(FieldValue::Boolean(v)) => Some(*v), _ => None }
+}
+
+pub(crate) fn gamerules_float(ctx: &Context, name: &str) -> Option<f32> {
+    let proxy = ctx.entities().get_by_class_name("CCSGameRulesProxy").ok()?;
+    match proxy.get_property_by_name(name) { Ok(FieldValue::Float(v)) if v.is_finite() => Some(*v), _ => None }
+}
