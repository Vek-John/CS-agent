+// Controller m_hPlayerPawn is already network-packed: never apply native conversion.
+// Sampling requires this controller to be the unique current owner of that pawn.
+pub(crate) fn verified_controller_pawn<'a>(ctx: &'a Context, controller: &Entity) -> Option<&'a Entity> {
+    if controller.class().name() != "CCSPlayerController" { return None; }
+    let steam = prop_u64(controller, "m_steamID");
+    if steam == 0 || steam == u64::MAX { return None; }
+    let packed = match controller.get_property_by_name("m_hPlayerPawn") {
+        Ok(FieldValue::Unsigned32(h)) if *h < 0xffffff => *h,
+        _ => return None,
+    };
+    let pawn = ctx.entities().get_by_index((packed & 0x3fff) as usize).ok()?;
+    let bindings = ctx.entities().iter().filter(|e| e.class().name() == "CCSPlayerController").filter_map(|ctrl| {
+        match ctrl.get_property_by_name("m_hPlayerPawn") {
+            Ok(FieldValue::Unsigned32(h)) => Some((*h, prop_u64(ctrl, "m_steamID"))),
+            _ => None,
+        }
+    });
+    let owner = packed_pawn_owner(packed, pawn.class().name(), pawn.index(), pawn.serial(), bindings)?;
+    (owner == steam).then_some(pawn)
 }
 
