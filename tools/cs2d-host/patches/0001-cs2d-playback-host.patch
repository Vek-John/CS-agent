+function inferWinRate(replay: Cs2dReplay, selectedPlayerId: string): Promise<WinProbabilityTimelineV1> {
+  winRateWorker?.terminate()
+  const requestId = ++winRateRequestId
+  winRateWorker = new Worker(new URL('./analysis/csNetWinRate.worker.ts', import.meta.url), { type: 'module' })
+  return new Promise((resolve, reject) => {
+    const worker = winRateWorker!
+    worker.onmessage = (event: MessageEvent<WinRateWorkerResponse>) => {
+      const message = event.data
+      if (worker !== winRateWorker || message.requestId !== requestId) return
+      if (message.type === 'telemetry') {
