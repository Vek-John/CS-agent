+        // validation; it never crosses the bridge as raw Replay/model input.
+        console.info('[cs-net] runtime telemetry', message.telemetry)
+        emitPlaybackEvent({
+          type: 'ANALYSIS_TELEMETRY',
+          schemaVersion: 'cs2d-analysis-telemetry.v1',
+          selectedPlayerId,
+          telemetry: message.telemetry as never,
+        })
+        return
+      }
+      if (message.type === 'progress') {
+        emitPlaybackEvent({
+          type: 'ANALYSIS_PROGRESS',
+          schemaVersion: 'cs2d-analysis-progress.v1',
+          selectedPlayerId,
+          phase: message.phase === 'ready' ? 'inference' : message.phase,
+          completed: message.completed,
+          total: message.total,
+          detail: message.detail ?? '',
+        })
+        return
+      }
+      worker.terminate()
+      winRateWorker = null
+      if (message.type === 'ready') resolve(message.timeline)
+      else reject(new Error(message.message))
+    }
+    worker.onerror = (error) => {
+      worker.terminate()
+      winRateWorker = null
+      reject(new Error(error.message || '胜率模型 Worker 失败'))
+    }
+    const threadQuery = typeof route.query.csThreads === 'string' ? route.query.csThreads : undefined
+    const threads: RuntimeThreadRequest | undefined = threadQuery === '1' || threadQuery === '2' || threadQuery === '4' ? Number(threadQuery) as RuntimeThreadRequest : undefined
+    const batchQuery = typeof route.query.csBatch === 'string' && /^\d+$/.test(route.query.csBatch) ? Number(route.query.csBatch) : undefined
+    const providerQuery = route.query.csProvider
