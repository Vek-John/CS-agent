+/* CS2 AI Demo Coach localhost host: compact, current-tick roster cards. */
+.host-roster-card {
+  min-height: 44px;
+  box-shadow: 0 1px 0 rgb(255 255 255 / 0.04) inset, 0 8px 20px rgb(0 0 0 / 0.2);
+  transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1), border-color 150ms ease, opacity 150ms ease;
+}
+.host-roster-card:active {
+  transform: scale(0.98);
+}
+.host-roster-card--dead {
+  opacity: 0.42;
+  filter: saturate(0.55);
+}
+.host-roster-card--locked:disabled {
+  cursor: default;
+  opacity: 0.58;
+}
+.host-roster-card--target {
+  border-color: rgb(100 170 255 / 0.8);
+  box-shadow: 0 0 0 1px rgb(100 170 255 / 0.35), 0 1px 0 rgb(255 255 255 / 0.08) inset, 0 8px 20px rgb(0 0 0 / 0.2);
+}
+.host-roster-card--target:disabled {
+  cursor: pointer;
+  opacity: 1;
+}
+.host-roster-card__top {
+  background: #151922;
+}
+@media (prefers-reduced-motion: reduce) {
+  .host-roster-card { transition: none; }
+  .host-roster-card:active { transform: none; }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .host-roster-card__top { background: #151922; backdrop-filter: none; }
+}
+@media (prefers-contrast: more) {
+  .host-roster-card { border-width: 2px; }
+}
