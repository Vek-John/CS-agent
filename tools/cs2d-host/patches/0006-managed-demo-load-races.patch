+const pendingManagedImport = ref<{ requestId: string; file: File; generation: number; signal: AbortSignal } | null>(null)
+let managedLoadGeneration = 0
+let managedReadyGeneration = -1
+let managedLoadAbort: AbortController | null = null
+let managedParseTail: Promise<void> = Promise.resolve()
+
+function beginManagedLoad() {
+  managedLoadGeneration += 1
+  managedReadyGeneration = -1
+  managedLoadAbort?.abort()
+  managedLoadAbort = new AbortController()
+  winRateWorker?.terminate()
+  winRateWorker = null
+  hostSelectedPlayerId.value = null
+  hostStageReady.value = false
+  return { generation: managedLoadGeneration, signal: managedLoadAbort.signal }
+}
+
+function isManagedLoadCurrent(generation: number): boolean {
+  return generation === managedLoadGeneration
+}
+
+function assertManagedLoadCurrent(generation: number) {
+  if (!isManagedLoadCurrent(generation)) throw new Error('STALE_MANAGED_LOAD')
+}
+
+async function parseManagedFile(file: File, source: ManagedSource, generation: number) {
+  const parse = managedParseTail.catch(() => undefined).then(async () => {
+    assertManagedLoadCurrent(generation)
+    managedSource.value = source
+    await parser.parse(file)
+    assertManagedLoadCurrent(generation)
+    if (parser.status.value !== 'done' || !parser.replay.value) throw new Error('MANAGED_DEMO_PARSE_FAILED')
+    if (parser.demoContentHash.value?.toLowerCase() !== source.contentHash) {
+      throw new Error('CONTENT_HASH_MISMATCH')
+    }
+  })
+  managedParseTail = parse.then(() => undefined, () => undefined)
+  await parse
+}
+
+function managedReplayReady(source: ManagedSource, generation: number) {
+  assertManagedLoadCurrent(generation)
+  const replay = parser.replay.value
+  if (!replay || parser.demoContentHash.value?.toLowerCase() !== source.contentHash) {
+    throw new Error('CONTENT_HASH_MISMATCH')
+  }
+  managedSource.value = source
+  managedReadyGeneration = generation
+  hostStageReady.value = false
+  hostSelectedPlayerId.value = null
+  return replayReadyMessage({
+    ...replay,
+    demoContentHash: parser.demoContentHash.value ?? undefined,
+    hashLatencyMs: parser.hashLatencyMs.value ?? undefined,
+    managedSource: source,
+  })
+}
 
